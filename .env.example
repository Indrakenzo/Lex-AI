# Konfigurasi API Keys untuk Backend Vercel
# Jangan isi key asli di sini. Gunakan file ini hanya sebagai contoh (dokumentasi).
# Isi key asli langsung di Dashboard Vercel > Settings > Environment Variables

# API Key untuk model Claude, Deepseek, dan ChatGPT dari AgentRouter
AGENTROUTER_API_KEY=your_agentrouter_api_key_here

# API Key untuk model OpenRouter (Keluarga Gemma)
OPENROUTER_API_KEY=your_openrouter_api_key_here
